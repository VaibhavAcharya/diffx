{
  "name": "diffx",
  "version": "0.1.0",
  "description": "Browse uncommitted and unmerged changes across every Git repository and worktree in a directory, in your browser.",
  "license": "MIT",
  "author": "Vaibhav Acharya",
  "keywords": [
    "git",
    "diff",
    "worktree",
    "monorepo",
    "multi-repo",
    "code-review",
    "cli",
    "local"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VaibhavAcharya/diffx.git"
  },
  "homepage": "https://github.com/VaibhavAcharya/diffx#readme",
  "bugs": {
    "url": "https://github.com/VaibhavAcharya/diffx/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@11.18.0",
  "bin": {
    "diffx": "bin/diffx.mjs"
  },
  "files": [
    "bin",
    "server/db.mjs",
    "server/git.mjs",
    "server/picker.mjs",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "start": "node bin/diffx.mjs",
    "test": "node --test \"server/*.test.mjs\"",
    "prepack": "pnpm build",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "@pierre/diffs": "^1.4.2",
    "@pierre/trees": "1.0.0-beta.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
